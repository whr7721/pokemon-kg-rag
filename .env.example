# Neo4j Aura / 数据库
NEO4J_URL=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=your-username
NEO4J_PASSWORD=your-password
NEO4J_DB=your-database

# 增强 Schema 的向量索引名
VECTOR_INDEX=embedding_Chunk

# 向量模型：正式口径使用本地 BGE-M3
EMBED_ENGINE=bge
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# 若改用 OpenAI-compatible 向量 API（DashScope/SiliconFlow），再取消注释：
# EMBED_ENGINE=dashscope
# EMBED_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
# EMBED_KEY=your-api-key
# EMBED_MODEL=BAAI/bge-m3

# 学校大模型（LLM）
LLM_ENDPOINT=https://ai.tju.edu.cn/api/v3
LLM_MODEL=tju-llm
LLM_TOKEN=your-token