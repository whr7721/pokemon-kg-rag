# Neo4j Aura / 数据库
NEO4J_URL=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=your-username
NEO4J_PASSWORD=your-password
NEO4J_DB=your-database

# 增强 Schema 的向量索引名
VECTOR_INDEX=embedding_Chunk

# 全文索引口径（决定「按实体名召回」怎么查）
# 增强库的全文索引（按实体标签命名）；一般无需修改。
# FULLTEXT_INDEXES=pokemonFulltext,abilityFulltext,moveFulltext,formFulltext

# 向量模型：云端 OpenAI 兼容 API（BAAI/bge-m3，1024 维，与库内向量同空间）
EMBED_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
EMBED_API_KEY=your-api-key
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# 学校大模型（LLM）
LLM_ENDPOINT=https://ai.tju.edu.cn/api/v3
LLM_MODEL=tju-llm
LLM_TOKEN=your-token